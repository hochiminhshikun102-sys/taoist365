+
+/** Prefer one language when a leftover mixed `English 路 涓枃` string is still in fixtures. */
+export function oaSplitMixed(text: string, locale: OaUiLocale) {
+  const parts = text
+    .replace(/\s+/g, " ")
+    .trim()
+    .split(/\s*路\s*/)
+    .map((part) => part.trim())
+    .filter(Boolean);
+  if (parts.length < 2) return text;
+  const zhParts = parts.filter((part) => /[\u4e00-\u9fff]/.test(part));
+  const enParts = parts.filter((part) => !/[\u4e00-\u9fff]/.test(part));
+  if (locale === "en") return enParts.join(" 路 ") || text;
+  return zhParts.join(" 路 ") || text;
+}
