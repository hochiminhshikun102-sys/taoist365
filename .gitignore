# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# cache / temp
/.cache/
/cache/
/.tmp*/
/tmp/

# local backups / duplicate source drops
/manus-backup/
/Taoist365-Brand-System/

# local preview output
.civilization-preview.log
.preview-dev.*.log
.preview-screenshots/
screenshots-homepage-hero/

# P0-01A Preview Functions local state — never commit, never point at Production
.wrangler/
.preview-state/
.preview-state.zip
.preview-functions.log
.preview-probe.json

# generated preview helpers
.civilization-preview-server.mjs
.start-civilization-preview.ps1

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archived browser captures should not pollute lint or stable snapshots
docs/brand-civilization/archive/public-source-packs/Taoist365-Civilization-Assets/**/*sdk*.js
docs/brand-civilization/archive/public-source-packs/Taoist365-Civilization-Assets/**/*sdk*.map
